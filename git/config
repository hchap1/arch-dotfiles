[init]
    defaultBranch = main

[pull]
    rebase = true

[commit]
    gpgsign = true

[core]
    editor = nvim
    autocrlf = input

[color]
    ui = auto

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[rerere]
    enabled = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate --all
